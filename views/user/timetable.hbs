<main class="app">

  <header class="header" style="padding-bottom: 1.5rem;">
    <div class="subpage-header">
      <a href="/" class="back-btn">
        <i class="bi bi-chevron-left"></i> Back
      </a>
      <p class="brand-name" style="margin: 0; font-size: 1.1rem; color: #fff;">Timetable</p>
      <div style="width: 60px;"></div>
    </div>

    <div style="margin-top: 1rem;">
      <h1 style="font-size: 1.5rem; color: #fff; margin: 0; line-height: 1.2;">
        Batch Timetable
      </h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 0.85rem; margin: 0.25rem 0 0;">
        {{student.class}} • {{student.shift}} Shift
      </p>
    </div>
  </header>

  <section class="section" style="padding-top: 1.25rem;">

    <div class="card-box">
      <div class="card-box-header">
        <div class="card-box-title">
          <i class="bi bi-clock-history" style="color: #7c3aed;"></i>
          <span>Daily Schedule</span>
        </div>
        <span class="badge" style="background: #ede9fe; color: #6d28d9; font-size: 0.75rem; font-weight: 700;">Evening</span>
      </div>

      <div class="info-list">
        <div class="info-item">
          <span class="label"><i class="bi bi-sun"></i> 5:30 PM – 6:15 PM</span>
          <span class="val">Mathematics & Problem Solving</span>
        </div>
        <div class="info-item">
          <span class="label"><i class="bi bi-book"></i> 6:15 PM – 7:00 PM</span>
          <span class="val">Science & Homework Review</span>
        </div>
        <div class="info-item">
          <span class="label"><i class="bi bi-check-circle"></i> 7:00 PM – 7:30 PM</span>
          <span class="val">Doubt Clearance & Mentorship</span>
        </div>
      </div>
    </div>

  </section>

</main>
