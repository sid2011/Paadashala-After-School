<main class="app">

  <!-- HEADER -->
  <header class="header" style="padding-bottom: 1.5rem;">
    <div class="subpage-header">
      <a href="/" class="back-btn">
        <i class="bi bi-chevron-left"></i> Dashboard
      </a>
      <p class="brand-name" style="margin: 0; font-size: 1.1rem; color: #fff;">Performance & Marks</p>
      
      {{#if (gt allStudents.length 1)}}
        <select
          onchange="window.location.href='/marks?studentId=' + this.value"
          style="background: rgba(255, 255, 255, 0.2); color: #fff; border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 9999px; padding: 0.25rem 0.6rem; font-size: 0.75rem; font-weight: 600; outline: none; cursor: pointer;">
          {{#each allStudents}}
            <option value="{{this.studentId}}" style="color: #000;" {{#if (eq this.studentId ../student.studentId)}}selected{{/if}}>
              {{this.name}}
            </option>
          {{/each}}
        </select>
      {{else}}
        <div style="width: 60px;"></div>
      {{/if}}
    </div>

    <div style="margin-top: 1rem;">
      <h1 style="font-size: 1.5rem; color: #fff; margin: 0; line-height: 1.2;">
        {{#if student.name}}{{student.name}}{{else}}Student{{/if}}'s Report Card
      </h1>
      <p style="color: rgba(255,255,255,0.85); font-size: 0.85rem; margin: 0.25rem 0 0;">
        School Exam vs Paadashala Coaching Comparison
      </p>
    </div>
  </header>

  <section class="section" style="padding-top: 1.25rem;">

    {{#unless activeReport}}
      <div class="card-box text-center py-5" style="text-align: center;">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: #e0f2fe; color: #0284c7; display: inline-flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 0.85rem;">
          <i class="bi bi-bar-chart-line"></i>
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; color: #1e293c; margin-bottom: 0.35rem;">Marks Report Pending</h3>
        <p style="color: #64748b; font-size: 0.875rem; max-width: 320px; margin: 0 auto;">
          ഈ വിദ്യാർത്ഥിയുടെ പരീക്ഷാ മാർക്കുകൾ അധ്യാപകർ തയ്യാറാക്കി കൊണ്ടിരിക്കുകയാണ്. ഉടൻ ലഭ്യമാകും.
        </p>
      </div>
    {{else}}

      <!-- EXAM TERM SELECTOR TABS -->
      {{#if (gt allReports.length 1)}}
        <div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.75rem; margin-bottom: 0.5rem;">
          {{#each allReports}}
            <a
              href="/marks?studentId={{../student.studentId}}&reportId={{this._id}}"
              style="text-decoration: none; padding: 0.45rem 0.85rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 700; white-space: nowrap; {{#if (eq this._id ../activeReport._id)}}background: #0284c7; color: #fff;{{else}}background: #ffffff; color: #475569; border: 1px solid #cbd5e1;{{/if}}">
              {{this.examTerm}}
            </a>
          {{/each}}
        </div>
      {{/if}}

      <!-- 1. SUMMARY COMPARISON KPI CARDS -->
      <div class="card-box" style="background: linear-gradient(135deg, #ffffff, #f8fafc); border: 1.5px solid #e2e8f0;">
        <div class="card-box-header" style="border-bottom: 1px dashed #e2e8f0;">
          <div class="card-box-title">
            <i class="bi bi-award" style="color: #0284c7;"></i>
            <span>{{activeReport.examTerm}}</span>
          </div>
          <span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: 0.75rem;">
            +{{activeReport.improvement}}% Progress
          </span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.65rem; text-align: center; margin-top: 0.5rem;">
          <div style="background: #eff6ff; padding: 0.75rem 0.5rem; border-radius: 0.85rem; border: 1px solid #dbeafe;">
            <span style="font-size: 0.7rem; color: #2563eb; font-weight: 700; text-transform: uppercase; display: block;">School Exam</span>
            <strong style="font-size: 1.15rem; color: #1e40af; display: block; margin-top: 0.2rem;">{{activeReport.schoolPercentage}}%</strong>
            <small style="font-size: 0.68rem; color: #3b82f6;">{{activeReport.totalSchool}} / {{activeReport.totalMax}}</small>
          </div>

          <div style="background: #ecfdf5; padding: 0.75rem 0.5rem; border-radius: 0.85rem; border: 1px solid #a7f3d0;">
            <span style="font-size: 0.7rem; color: #059669; font-weight: 700; text-transform: uppercase; display: block;">Paadashala</span>
            <strong style="font-size: 1.15rem; color: #047857; display: block; margin-top: 0.2rem;">{{activeReport.paadashalaPercentage}}%</strong>
            <small style="font-size: 0.68rem; color: #10b981;">{{activeReport.totalPaadashala}} / {{activeReport.totalMax}}</small>
          </div>

          <div style="background: #fff7ed; padding: 0.75rem 0.5rem; border-radius: 0.85rem; border: 1px solid #fed7aa;">
            <span style="font-size: 0.7rem; color: #ea580c; font-weight: 700; text-transform: uppercase; display: block;">Growth</span>
            <strong style="font-size: 1.15rem; color: #c2410c; display: block; margin-top: 0.2rem;">+{{activeReport.improvement}}%</strong>
            <small style="font-size: 0.68rem; color: #ea580c;">Improvement</small>
          </div>
        </div>

        {{#if activeReport.remarks}}
          <div style="margin-top: 1rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 0.75rem; padding: 0.75rem; font-size: 0.85rem; color: #166534; display: flex; align-items: flex-start; gap: 0.5rem;">
            <i class="bi bi-chat-heart-fill" style="color: #16a34a; font-size: 1.1rem; flex-shrink: 0; margin-top: 0.1rem;"></i>
            <div>
              <strong>Overall Assessment & Progress:</strong> {{activeReport.remarks}}
            </div>
          </div>
        {{/if}}
      </div>

      <!-- 2. INTERACTIVE COMPARISON GRAPH CARD -->
      <div class="card-box" style="padding: 1rem;">
        <div class="card-box-header" style="margin-bottom: 0.75rem; padding-bottom: 0.5rem;">
          <div class="card-box-title" style="font-size: 1rem;">
            <i class="bi bi-bar-chart-fill" style="color: #2563eb;"></i>
            <span>School vs Paadashala Subject Comparison</span>
          </div>
          <span style="font-size: 0.75rem; color: #64748b;">Interactive Graph</span>
        </div>

        <div style="position: relative; width: 100%; height: 260px;">
          <canvas id="marksComparisonChart"></canvas>
        </div>

        <div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem; margin-top: 0.85rem; font-size: 0.8rem; font-weight: 700;">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span style="width: 14px; height: 14px; border-radius: 4px; background: #3b82f6; display: inline-block;"></span>
            <span style="color: #1e3a8a;">School Exam (സ്കൂൾ)</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span style="width: 14px; height: 14px; border-radius: 4px; background: #10b981; display: inline-block;"></span>
            <span style="color: #064e3b;">Paadashala (പാഠശാല)</span>
          </div>
        </div>
      </div>

      <!-- 3. SUBJECT-WISE DETAILED MARKS TABLE -->
      <div class="card-box" style="padding: 1rem;">
        <div class="card-box-header" style="margin-bottom: 0.75rem; padding-bottom: 0.5rem;">
          <div class="card-box-title" style="font-size: 1rem;">
            <i class="bi bi-card-list" style="color: #0284c7;"></i>
            <span>Subject-wise Marks Breakdown</span>
          </div>
          <span style="font-size: 0.75rem; color: #64748b;">{{activeReport.subjects.length}} Subjects</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.65rem;">
          {{#each activeReport.subjects}}
            <div style="border: 1px solid #e2e8f0; border-radius: 0.85rem; padding: 0.75rem; background: #ffffff;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <strong style="font-size: 0.95rem; color: #0f172a;">{{this.name}}</strong>
                <span class="badge" style="background: #f1f5f9; color: #475569; font-size: 0.7rem;">Max: {{this.maxMarks}}</span>
              </div>

              <!-- Marks Bar & Stats -->
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
                <div>
                  <span style="color: #64748b; font-size: 0.75rem;">School:</span>
                  <strong style="color: #2563eb; font-size: 0.9rem; margin-left: 0.2rem;">{{this.schoolMarks}}</strong>
                </div>

                <div>
                  <span style="color: #64748b; font-size: 0.75rem;">Paadashala:</span>
                  <strong style="color: #059669; font-size: 0.95rem; margin-left: 0.2rem;">{{this.paadashalaMarks}}</strong>
                </div>

                <div>
                  <span style="background: #dcfce7; color: #166534; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 9999px;">
                    <i class="bi bi-graph-up-arrow me-1"></i>+{{this.difference}}
                  </span>
                </div>
              </div>

              {{#if this.remarks}}
                <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.4rem; padding-top: 0.35rem; border-top: 1px dashed #f1f5f9;">
                  <i class="bi bi-info-circle me-1 text-secondary"></i>{{this.remarks}}
                </div>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </div>

    {{/unless}}

  </section>

</main>

<!-- CHART.JS OFFICIAL LIBRARY -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  {{#if activeReport}}
    const ctx = document.getElementById('marksComparisonChart');
    if (!ctx) return;

    const subjects = {{{json chartSubjects}}};
    const schoolData = {{{json chartSchoolMarks}}};
    const paadashalaData = {{{json chartPaadashalaMarks}}};

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: subjects,
        datasets: [
          {
            label: 'School Exam',
            data: schoolData,
            backgroundColor: '#3b82f6',
            borderColor: '#2563eb',
            borderWidth: 1,
            borderRadius: 6,
            barPercentage: 0.7,
            categoryPercentage: 0.7
          },
          {
            label: 'Paadashala Exam',
            data: paadashalaData,
            backgroundColor: '#10b981',
            borderColor: '#059669',
            borderWidth: 1,
            borderRadius: 6,
            barPercentage: 0.7,
            categoryPercentage: 0.7
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y + ' Marks';
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            max: 100,
            ticks: {
              stepSize: 20,
              font: {
                family: 'Nunito',
                size: 11
              }
            },
            grid: {
              color: '#f1f5f9'
            }
          },
          x: {
            ticks: {
              font: {
                family: 'Nunito',
                weight: 'bold',
                size: 11
              }
            },
            grid: {
              display: false
            }
          }
        }
      }
    });
  {{/if}}
});
</script>
