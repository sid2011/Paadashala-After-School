<div class="students-page-container p-3 p-md-4">

    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="page-title m-0">Students Management</h1>
            <p class="text-muted m-0">വിദ്യാർത്ഥികളുടെ പട്ടികയും പുതിയ അഡ്മിഷനും</p>
        </div>

        <button
            class="btn btn-primary d-flex align-items-center gap-2"
            data-bs-toggle="modal"
            data-bs-target="#registerStudentModal">
            <i class="bi bi-person-plus-fill"></i>
            <span>Register Student</span>
        </button>
    </div>

    <!-- REGISTER STUDENT MODAL -->
    <div
        class="modal fade"
        id="registerStudentModal"
        tabindex="-1"
        aria-labelledby="registerStudentModalLabel"
        aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content" style="border-radius: 18px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">

                <form action="/admin/students/register" method="POST">

                    <!-- HEADER -->
                    <div class="modal-header bg-light border-bottom px-4 py-3">
                        <div>
                            <h4 class="modal-title fw-bold text-dark m-0" id="registerStudentModalLabel">
                                <i class="bi bi-mortarboard-fill text-primary me-2"></i> Register New Student
                            </h4>
                            <small class="text-muted">പുതിയ വിദ്യാർത്ഥിയുടെ വിവരങ്ങൾ ചേർക്കുക</small>
                        </div>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        </button>
                    </div>

                    <!-- BODY -->
                    <div class="modal-body p-4">

                        <!-- STUDENT NAME -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Student Full Name <span class="text-danger">*</span>
                            </label>
                            <input
                                class="form-control"
                                type="text"
                                name="name"
                                placeholder="e.g. Rahul Krishna"
                                required>
                        </div>

                        <!-- PARENT NAME + PHONE -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">
                                    Parent / Guardian Name <span class="text-danger">*</span>
                                </label>
                                <input
                                    class="form-control"
                                    type="text"
                                    name="parentName"
                                    placeholder="e.g. Radhakrishnan"
                                    required>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">
                                    Parent Contact Number <span class="text-danger">*</span>
                                </label>
                                <input
                                    class="form-control"
                                    type="tel"
                                    name="phone"
                                    placeholder="e.g. 9876543210"
                                    required>
                            </div>
                        </div>

                        <!-- CLASS + SHIFT + ACADEMIC YEAR -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold text-secondary small">
                                    Class / Standard <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" name="class" required>
                                    <option value="" disabled selected>Select Class</option>
                                    <option value="Class 1">Class 1</option>
                                    <option value="Class 2">Class 2</option>
                                    <option value="Class 3">Class 3</option>
                                    <option value="Class 4">Class 4</option>
                                    <option value="Class 5">Class 5</option>
                                    <option value="Class 6">Class 6</option>
                                    <option value="Class 7">Class 7</option>
                                    <option value="Class 8">Class 8</option>
                                    <option value="Class 9">Class 9</option>
                                    <option value="Class 10">Class 10</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold text-secondary small">
                                    Shift / Batch Time <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" name="shift" required>
                                    <option value="Morning">Morning (6:30 AM – 8:30 AM)</option>
                                    <option value="Afternoon">Afternoon (3:30 PM – 5:30 PM)</option>
                                    <option value="Evening" selected>Evening (5:30 PM – 7:30 PM)</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold text-secondary small">
                                    Academic Year <span class="text-danger">*</span>
                                </label>
                                <input
                                    class="form-control"
                                    type="text"
                                    name="academicYear"
                                    value="2026-2027"
                                    required>
                            </div>
                        </div>

                        <!-- MONTHLY FEE & ADMISSION START MONTH -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">
                                    Monthly Fee (₹) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold text-secondary">₹</span>
                                    <input
                                        class="form-control"
                                        type="number"
                                        name="monthlyFee"
                                        placeholder="e.g. 5000"
                                        min="1"
                                        max="1000000"
                                        step="1"
                                        required>
                                </div>
                                <div class="form-text small text-muted">പ്രതിമാസ ഫീസ് തുക (ഉദാ: 5000, 6000)</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">
                                    Fee Start / Admission Month <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" name="admissionMonth" required>
                                    <option value="June" selected>June (Academic Start)</option>
                                    <option value="July">July</option>
                                    <option value="August">August</option>
                                    <option value="September">September</option>
                                    <option value="October">October</option>
                                    <option value="November">November</option>
                                    <option value="December">December</option>
                                    <option value="January">January</option>
                                    <option value="February">February</option>
                                    <option value="March">March</option>
                                </select>
                                <div class="form-text small text-muted">കുട്ടി ചേരുന്ന മാസം മുതൽ മാത്രം ഫീസ് കണക്കാക്കും</div>
                            </div>
                        </div>

                        <!-- ADDRESS -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Residential Address
                            </label>
                            <textarea
                                class="form-control"
                                rows="3"
                                name="address"
                                placeholder="Enter student's address"></textarea>
                        </div>

                        <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0" style="border-radius: 10px;">
                            <i class="bi bi-info-circle-fill fs-5"></i>
                            <div>വിദ്യാർത്ഥിയുടെ Student ID തനിയെ സിസ്റ്റം ജനറേറ്റ് ചെയ്യുന്നതാണ്.</div>
                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="modal-footer bg-light px-4 py-3">
                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button
                            type="submit"
                            class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle"></i>
                            <span>Register Student</span>
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- STUDENTS LIST TABLE CARD -->
    <div class="dash-card">
        <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h3 class="dash-card-title">
                    <i class="bi bi-people-fill text-primary me-2"></i> All Registered Students
                </h3>
                <span class="text-muted small">Total: {{student.length}} Students</span>
            </div>
        </div>

        <div class="dash-card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover students-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50px;">No</th>
                            <th>Student ID</th>
                            <th>Student Name</th>
                            <th>Class</th>
                            <th>Shift / Batch</th>
                            <th>Parent Name</th>
                            <th>Parent Phone</th>
                            <th>Monthly Fee</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if student.length}}
                            {{#each student}}
                                <tr>
                                    <td class="text-muted fw-bold">{{inc @index}}</td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">
                                            {{this.studentId}}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">{{this.name}}</div>
                                        <small class="text-muted">{{this.academicYear}}</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                            {{this.class}}
                                        </span>
                                    </td>
                                    <td>
                                        {{#if (eq this.shift "Morning")}}
                                            <span class="badge bg-warning text-dark px-2 py-1">
                                                <i class="bi bi-sun-fill me-1"></i> Morning
                                            </span>
                                        {{else if (eq this.shift "Afternoon")}}
                                            <span class="badge bg-info text-dark px-2 py-1">
                                                <i class="bi bi-brightness-high-fill me-1"></i> Afternoon
                                            </span>
                                        {{else if (eq this.shift "Evening")}}
                                            <span class="badge bg-primary px-2 py-1">
                                                <i class="bi bi-moon-stars-fill me-1"></i> Evening
                                            </span>
                                        {{else}}
                                            <span class="badge bg-light text-dark border px-2 py-1">General</span>
                                        {{/if}}
                                    </td>
                                    <td>{{this.parentName}}</td>
                                    <td>
                                        <a href="tel:{{this.parentNo}}" class="text-decoration-none text-dark fw-semibold">
                                            <i class="bi bi-telephone me-1 text-muted"></i> {{this.parentNo}}
                                        </a>
                                    </td>
                                    <td>
                                        {{#if this.monthlyFee}}
                                            <div class="fw-bold text-dark font-monospace">₹{{formatCurrency this.monthlyFee}}</div>
                                            <small class="text-muted">/ month</small>
                                        {{else}}
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle py-1">
                                                Not Configured
                                            </span>
                                        {{/if}}
                                    </td>
                                    <td>
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 open-fee-modal-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editFeeModal"
                                            data-student-id="{{this.studentId}}"
                                            data-student-name="{{this.name}}"
                                            data-current-fee="{{this.monthlyFee}}">
                                            <i class="bi bi-cash-stack"></i>
                                            <span>{{#if this.monthlyFee}}Edit Fee{{else}}Set Fee{{/if}}</span>
                                        </button>
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <div class="mb-2"><i class="bi bi-inbox fs-1 text-secondary"></i></div>
                                    <div>ഇതുവരെ കുട്ടികളെ രജിസ്റ്റർ ചെയ്തിട്ടില്ല.</div>
                                    <small>മുകളിലുള്ള 'Register Student' ബട്ടൺ ഉപയോഗിച്ച് ചേർക്കുക.</small>
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- EDIT / SET FEE MODAL -->
    <div class="modal fade" id="editFeeModal" tabindex="-1" aria-labelledby="editFeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
                <form action="/admin/students/update-fee" method="POST">
                    <input type="hidden" name="studentId" id="modalStudentId">
                    <div class="modal-header bg-light border-bottom px-4 py-3">
                        <div>
                            <h5 class="modal-title fw-bold text-dark m-0" id="editFeeModalLabel">
                                <i class="bi bi-cash-coin text-primary me-2"></i> Configure Monthly Fee
                            </h5>
                            <small class="text-muted" id="modalStudentNameSubtitle"></small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Monthly Fee Amount (₹) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-secondary">₹</span>
                                <input
                                    type="number"
                                    name="monthlyFee"
                                    id="modalMonthlyFeeInput"
                                    class="form-control"
                                    placeholder="e.g. 5000"
                                    min="1"
                                    max="1000000"
                                    step="1"
                                    required>
                            </div>
                            <div class="form-text small text-muted mt-2">
                                ഫീസ് മാറ്റങ്ങൾ വരാനിരിക്കുന്ന (unpaid) മാസങ്ങളിലേക്ക് മാത്രമേ ബാധകമാകൂ. ഇതിനകം അടച്ച ഫീസിൽ മാറ്റം വരില്ല.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle"></i> Save Fee
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var feeModal = document.getElementById('editFeeModal');
            if (feeModal) {
                feeModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    if (!button) return;
                    var studentId = button.getAttribute('data-student-id');
                    var studentName = button.getAttribute('data-student-name');
                    var currentFee = button.getAttribute('data-current-fee') || '';

                    var modalStudentId = document.getElementById('modalStudentId');
                    var modalStudentNameSubtitle = document.getElementById('modalStudentNameSubtitle');
                    var modalMonthlyFeeInput = document.getElementById('modalMonthlyFeeInput');

                    if (modalStudentId) modalStudentId.value = studentId || '';
                    if (modalStudentNameSubtitle) modalStudentNameSubtitle.textContent = (studentName || 'Student') + ' (' + studentId + ')';
                    if (modalMonthlyFeeInput) modalMonthlyFeeInput.value = currentFee || '';
                });
            }
        });
    </script>
</div>
