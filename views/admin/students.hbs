<div class="page-header">

    <div>
        <h1>Students</h1>
        <p>Manage all Paadashala students</p>
    </div>

    <button
        class="btn btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#registerStudentModal">

        <i class="bi bi-person-plus"></i>
        Register Student

    </button>

</div>
<!-- REGISTER STUDENT MODAL -->
<div
    class="modal fade"
    id="registerStudentModal"
    tabindex="-1"
    aria-labelledby="registerStudentModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form action="/admin/students/register" method="POST">


                <!-- HEADER -->

                <div class="modal-head">

                    <div>

                        <h3 id="registerStudentModalLabel">

                            <i
                                class="bi bi-person-plus-fill"
                                style="color:var(--p);margin-right:.35rem">
                            </i>

                            Register Student

                        </h3>

                        <p>Add a new student to Paadashala.</p>

                    </div>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body">


                    <!-- STUDENT NAME -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Student Name <span class="req">*</span>
                        </label>

                        <input
                            class="finput"
                            type="text"
                            name="name"
                            placeholder="Enter student's full name"
                            required>

                    </div>


                    <!-- PARENT NAME -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Parent / Guardian Name
                            <span class="req">*</span>
                        </label>

                        <input
                            class="finput"
                            type="text"
                            name="parentName"
                            placeholder="Enter parent or guardian name"
                            required>

                    </div>


                    <!-- PHONE + CLASS -->

                    <div class="form-row form-mb">

                        <div>

                            <label class="form-lbl">
                                Parent Phone <span class="req">*</span>
                            </label>

                            <input
                                class="finput"
                                type="tel"
                                name="phone"
                                placeholder="Enter phone number"
                                required>

                        </div>


                        <div>

                            <label class="form-lbl">
                                Class <span class="req">*</span>
                            </label>

                            <select
                                class="finput fselect"
                                name="class"
                                required>

                                <option value="">
                                    Select class…
                                </option>

                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="8">8</option>
                                <option value="9">9</option>
                                <option value="10">10</option>

                            </select>

                        </div>

                    </div>


                    <!-- ACADEMIC YEAR -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Academic Year <span class="req">*</span>
                        </label>

                        <select
                            class="finput fselect"
                            name="academicYear"
                            required>

                            <option value="">
                                Select year…
                            </option>

                            <option value="2026-2027">
                                2026–2027
                            </option>

                        </select>

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Address
                        </label>

                        <textarea
                            class="finput"
                            rows="3"
                            name="address"
                            placeholder="Enter student's address">
                        </textarea>

                    </div>


                    <!-- INFO -->

                    <div class="xp-hint-box">

                        <i
                            class="bi bi-info-circle-fill"
                            style="color:var(--p);margin-right:.25rem">
                        </i>

                        A student ID and login credentials can be
                        generated after registration.

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary">

                        <i class="bi bi-person-plus-fill"></i>

                        Register Student

                    </button>

                </div>


            </form>

        </div>

    </div>

</div>
<div class="students-container">

    <h1>Students</h1>

    <div class="table-wrapper">
        <table class="table students-table mt-3">

            <thead>
                <tr>
                    <th>No</th>
                    <th>Student Id</th>
                    <th>Name</th>
                    <th>Parent Name</th>
                    <th>Parent Phone no</th>
                    <th>Class</th>
                    <th>Address</th>
                </tr>
            </thead>

            <tbody>

                {{#each student}}

                <tr>
                    <th scope="row">{{inc @index}}</th>
                    <td>{{this.studentId}}</td>
                    <td>{{this.name}}</td>
                    <td>{{this.parentName}}</td>
                    <td>{{this.parentNo}}</td>
                    <td>{{this.class}}</td>
                    <td>{{this.address}}</td>
                </tr>

                {{/each}}

            </tbody>

        </table>
    </div>

</div>