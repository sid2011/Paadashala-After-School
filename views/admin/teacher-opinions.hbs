<div class="teacher-opinions-page p-3 p-md-4">

  <!-- Heading -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="page-title m-0">Teacher Opinions & Voice Feedback</h1>
      <p class="text-muted m-0">കുട്ടികളുടെ പഠന നിലവാരവും വിഷയങ്ങൾ തിരിച്ചുള്ള അധ്യാപകരുടെ വിലയിരുത്തലുകളും</p>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <!-- OPINION ENTRY & VOICE RECORDING CARD -->
    <div class="col-12 col-xl-5">
      <div class="dash-card h-100">
        <div class="dash-card-header bg-light border-bottom">
          <h3 class="dash-card-title">
            <i class="bi bi-mic-fill text-danger me-2"></i> Record Opinion
          </h3>
          <span class="text-muted small">വോയ്സ് അല്ലെങ്കിൽ ടെക്സ്റ്റ് വഴി അഭിപ്രായം രേഖപ്പെടുത്താം</span>
        </div>

        <div class="dash-card-body p-4">
          <form id="opinionForm" action="/admin/teacher-opinions" method="POST">

            <!-- CLASS SELECTION -->
            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary small" for="opinionClassSelect">
                Select Class <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="opinionClassSelect" name="class" required>
                <option value="" disabled selected>-- ക്ലാസ്സ് തെരഞ്ഞെടുക്കുക --</option>
                <option value="Class 1">Class 1</option>
                <option value="Class 2">Class 2</option>
                <option value="Class 3">Class 3</option>
                <option value="Class 4">Class 4</option>
                <option value="Class 5">Class 5</option>
                <option value="Class 6">Class 6</option>
                <option value="Class 7">Class 7</option>
                <option value="Class 8">Class 8</option>
                <option value="Class 9">Class 9</option>
                <option value="Class 10">Class 10</option>
              </select>
            </div>

            <!-- STUDENT SELECTION -->
            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary small" for="opinionStudentSelect">
                Select Student <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="opinionStudentSelect" name="studentId" required disabled>
                <option value="">-- ആദ്യം ക്ലാസ്സ് തെരഞ്ഞെടുക്കുക --</option>
              </select>
              <input type="hidden" id="opinionStudentName" name="studentName" value="" />
            </div>

            <!-- SUBJECT SELECTION -->
            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary small" for="opinionSubjectSelect">
                Select Subject <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="opinionSubjectSelect" name="subject" required>
                <option value="" disabled selected>-- വിഷയം തെരഞ്ഞെടുക്കുക --</option>
                <option value="Mathematics">Mathematics (കണക്ക്)</option>
                <option value="Physics">Physics (ഫിസിക്സ്)</option>
                <option value="Chemistry">Chemistry (കെമിസ്ട്രി)</option>
                <option value="Biology">Biology (ബയോളജി)</option>
                <option value="English">English (ഇംഗ്ലീഷ്)</option>
                <option value="Malayalam">Malayalam (മലയാളം)</option>
                <option value="Social Science">Social Science (സോഷ്യൽ സയൻസ്)</option>
                <option value="Hindi">Hindi (ഹിന്ദി)</option>
                <option value="General Studies">General Studies & Homework</option>
              </select>
            </div>

            <!-- TEACHER NAME -->
            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary small" for="opinionTeacher">
                Teacher Name <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="opinionTeacher" name="teacherName" required>
                <option value="" disabled selected>-- അധ്യാപകരെ തെരഞ്ഞെടുക്കുക --</option>
                {{#if teachers.length}}
                  {{#each teachers}}
                    <option value="{{this.name}}">{{this.name}} ({{this.subject}})</option>
                  {{/each}}
                {{else}}
                  <option value="Subject Teacher">Subject Teacher</option>
                {{/if}}
              </select>
            </div>

            <!-- VOICE RECORDING CONTROLS -->
            <div class="voice-box p-3 mb-3" style="background: #f8fafc; border-radius: 14px; border: 1.5px dashed #cbd5e1;">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <span class="fw-bold small text-dark d-flex align-items-center gap-1">
                  <i class="bi bi-mic-fill text-danger"></i> Speech-to-Text Voice Input
                </span>

                <!-- Language Toggle -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Speech Language">
                  <input type="radio" class="btn-check" name="speechLang" id="langMl" value="ml-IN" checked autocomplete="off">
                  <label class="btn btn-outline-secondary" for="langMl">മലയാളം</label>

                  <input type="radio" class="btn-check" name="speechLang" id="langEn" value="en-IN" autocomplete="off">
                  <label class="btn btn-outline-secondary" for="langEn">English</label>
                </div>
              </div>

              <!-- Big Voice Record Button -->
              <div class="text-center my-3">
                <button type="button" id="startVoiceBtn" class="btn btn-outline-danger px-4 py-2 rounded-pill fw-bold d-inline-flex align-items-center gap-2 shadow-sm">
                  <i class="bi bi-mic fs-5"></i>
                  <span id="voiceBtnText">Click to Speak (സംസാരിച്ചു തുടങ്ങൂ)</span>
                </button>
                <div id="voiceStatus" class="small text-muted mt-2">
                  മൈക്ക് ക്ലിക്ക് ചെയ്ത് അധ്യാപകന് പറയാം, അത് തനിയെ ടെക്സ്റ്റായി മാറും.
                </div>
              </div>
            </div>

            <!-- OPINION TEXTAREA -->
            <div class="mb-4">
              <label class="form-label fw-semibold text-secondary small" for="opinionText">
                Teacher Opinion / Feedback Note <span class="text-danger">*</span>
              </label>
              <textarea
                class="form-control"
                id="opinionText"
                name="opinion"
                rows="4"
                placeholder="സംസാരിക്കുന്ന വാക്കുകൾ ഇവിടെ തത്സമയം ടൈപ്പ് ചെയ്യപ്പെടും, അല്ലെങ്കിൽ നേരിട്ട് ടൈപ്പ് ചെയ്യാം..."
                required></textarea>
              <small class="text-muted">ആവശ്യമെങ്കിൽ നിങ്ങൾക്ക് ഈ ടെക്സ്റ്റ് നേരിട്ട് തിരുത്താനും സാധിക്കും.</small>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2">
              <i class="bi bi-save2-fill"></i>
              <span>Save Teacher Opinion</span>
            </button>

          </form>
        </div>
      </div>
    </div>

    <!-- SAVED OPINIONS LIST -->
    <div class="col-12 col-xl-7">
      <div class="dash-card h-100">
        <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <h3 class="dash-card-title">
              <i class="bi bi-journal-text text-primary me-2"></i> Opinion History
            </h3>
            <span class="text-muted small">രേഖപ്പെടുത്തിയ വിലയിരുത്തലുകൾ</span>
          </div>
          <span class="badge bg-primary-subtle text-primary">{{opinions.length}} Records</span>
        </div>

        <div class="dash-card-body p-0">
          <div class="opinion-list p-3" style="max-height: 680px; overflow-y: auto;">
            {{#if opinions.length}}
              {{#each opinions}}
                <div class="card opinion-card mb-3 border" style="border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                  <div class="card-body p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                      <div>
                        <h5 class="m-0 fw-bold text-dark d-flex align-items-center gap-2">
                          <i class="bi bi-person-circle text-primary"></i>
                          <span>{{this.studentName}}</span>
                        </h5>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                          <span class="badge bg-secondary-subtle text-secondary">{{this.class}}</span>
                          <span class="badge bg-info-subtle text-info-emphasis fw-semibold">
                            <i class="bi bi-book me-1"></i>{{this.subject}}
                          </span>
                        </div>
                      </div>

                      <div class="text-end">
                        <small class="text-muted d-block"><i class="bi bi-clock me-1"></i>{{formatDate this.createdAt}}</small>
                        <small class="badge bg-light text-dark border">By: {{this.teacherName}}</small>
                      </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mt-2 text-secondary" style="font-size: 0.95rem; line-height: 1.5; border-left: 3px solid #3b82f6;">
                      {{this.opinion}}
                    </div>
                  </div>
                </div>
              {{/each}}
            {{else}}
              <div class="text-center py-5 text-muted">
                <i class="bi bi-chat-square-quote fs-1 text-secondary d-block mb-2"></i>
                <div>ഇതുവരെ ഒപ്പീനിയനുകൾ രേഖപ്പെടുത്തിയിട്ടില്ല.</div>
                <small>ഇടതുവശത്തുള്ള ഫോം ഉപയോഗിച്ച് വോയ്സ് വഴിയോ നേരിട്ടോ അഭിപ്രായം ചേർക്കുക.</small>
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
