<div class="dashboard-wrapper p-3 p-md-4">

  <!-- Welcome Hero Banner -->
  <div class="welcome-hero mb-4">
    <div class="welcome-content">
      <div class="welcome-badge">
        <i class="bi bi-stars"></i> Academic Session 2026–2027
      </div>
      <h1 class="welcome-title">Welcome back, Admin! 👋</h1>
      <p class="welcome-desc">
        പാഠശാല ആഫ്റ്റർ സ്കൂൾ മാനേജ്‌മെന്റ് പോർട്ടലിലേക്ക് സ്വാഗതം. വിദ്യാർത്ഥികളുടെ ഹാജർ നിലയും പുരോഗതിയും അധ്യാപകരുടെ വിലയിരുത്തലുകളും ഇവിടെ നിയന്ത്രിക്കാം.
      </p>
      <div class="welcome-actions mt-3">
        <a href="/admin/students/attendance" class="admin-page-link hero-btn hero-btn-primary">
          <i class="bi bi-calendar2-check-fill"></i> Mark Attendance
        </a>
        <a href="/admin/teacher-opinions" class="admin-page-link hero-btn hero-btn-secondary">
          <i class="bi bi-mic-fill"></i> Teacher Opinions
        </a>
      </div>
    </div>
    <div class="welcome-graphic d-none d-lg-flex">
      <div class="pulse-circle">
        <i class="bi bi-mortarboard-fill"></i>
      </div>
    </div>
  </div>

  <!-- Stat Cards Grid -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-blue">
        <div class="stat-body">
          <span class="stat-label">Total Students</span>
          <h2 class="stat-value">{{totalStudents}}</h2>
          <span class="stat-sub"><i class="bi bi-check-circle"></i> Enrolled active learners</span>
        </div>
        <div class="stat-icon-wrap">
          <i class="bi bi-people-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-purple">
        <div class="stat-body">
          <span class="stat-label">Total Teachers</span>
          <h2 class="stat-value">{{totalTeachers}}</h2>
          <span class="stat-sub"><i class="bi bi-mortarboard"></i> Subject mentors</span>
        </div>
        <div class="stat-icon-wrap">
          <i class="bi bi-person-video3"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-amber">
        <div class="stat-body">
          <span class="stat-label">Morning Batch</span>
          <h2 class="stat-value">{{morningCount}}</h2>
          <span class="stat-sub"><i class="bi bi-sun-fill"></i> Morning Shift</span>
        </div>
        <div class="stat-icon-wrap">
          <i class="bi bi-sunrise-fill"></i>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="stat-card stat-teal">
        <div class="stat-body">
          <span class="stat-label">Afternoon & Evening</span>
          <h2 class="stat-value">{{afternoonEveningCount}}</h2>
          <span class="stat-sub"><i class="bi bi-moon-stars-fill"></i> Later Shifts</span>
        </div>
        <div class="stat-icon-wrap">
          <i class="bi bi-clock-history"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Shortcuts & Shift Information -->
  <div class="row g-4 mb-4">
    <!-- Quick Shortcuts Card -->
    <div class="col-12 col-lg-7">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <h3 class="dash-card-title">
            <i class="bi bi-lightning-charge-fill text-warning me-2"></i> Quick Operations
          </h3>
          <span class="text-muted small">Daily management actions</span>
        </div>
        <div class="dash-card-body">
          <div class="quick-grid">
            <a href="/admin/students" class="admin-page-link quick-tile">
              <div class="quick-icon q-students">
                <i class="bi bi-person-lines-fill"></i>
              </div>
              <div class="quick-info">
                <strong>Manage Students</strong>
                <small>View & Register students with shifts</small>
              </div>
              <i class="bi bi-chevron-right quick-arrow"></i>
            </a>

            <a href="/admin/teachers" class="admin-page-link quick-tile">
              <div class="quick-icon q-teachers">
                <i class="bi bi-person-badge-fill"></i>
              </div>
              <div class="quick-info">
                <strong>Manage Teachers</strong>
                <small>Faculty directory & assignments</small>
              </div>
              <i class="bi bi-chevron-right quick-arrow"></i>
            </a>

            <a href="/admin/students/attendance" class="admin-page-link quick-tile">
              <div class="quick-icon q-attendance">
                <i class="bi bi-calendar-check-fill"></i>
              </div>
              <div class="quick-info">
                <strong>Attendance System</strong>
                <small>Morning, Afternoon & Evening tracking</small>
              </div>
              <i class="bi bi-chevron-right quick-arrow"></i>
            </a>

            <a href="/admin/teacher-opinions" class="admin-page-link quick-tile">
              <div class="quick-icon q-opinions">
                <i class="bi bi-mic-fill"></i>
              </div>
              <div class="quick-info">
                <strong>Teacher Opinions</strong>
                <small>Speech-to-Text student feedback</small>
              </div>
              <i class="bi bi-chevron-right quick-arrow"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Shifts & Timings Overview -->
    <div class="col-12 col-lg-5">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <h3 class="dash-card-title">
            <i class="bi bi-clock-fill text-primary me-2"></i> After-School Shifts
          </h3>
          <span class="text-muted small">Batch timings</span>
        </div>
        <div class="dash-card-body">
          <div class="shift-schedule-list">
            <div class="shift-item shift-m">
              <div class="shift-dot"></div>
              <div class="shift-details">
                <div class="d-flex justify-content-between align-items-center">
                  <strong>Morning Shift</strong>
                  <span class="badge bg-warning text-dark">Morning</span>
                </div>
                <small class="text-muted"><i class="bi bi-clock"></i> 6:30 AM – 8:30 AM</small>
                <div class="shift-desc">Focused morning study & revision before school</div>
              </div>
            </div>

            <div class="shift-item shift-a">
              <div class="shift-dot"></div>
              <div class="shift-details">
                <div class="d-flex justify-content-between align-items-center">
                  <strong>Afternoon Shift</strong>
                  <span class="badge bg-info text-dark">Afternoon</span>
                </div>
                <small class="text-muted"><i class="bi bi-clock"></i> 3:30 PM – 5:30 PM</small>
                <div class="shift-desc">Homework assistance & subject doubt clearance</div>
              </div>
            </div>

            <div class="shift-item shift-e">
              <div class="shift-dot"></div>
              <div class="shift-details">
                <div class="d-flex justify-content-between align-items-center">
                  <strong>Evening Shift</strong>
                  <span class="badge bg-primary">Evening</span>
                </div>
                <small class="text-muted"><i class="bi bi-clock"></i> 5:30 PM – 7:30 PM</small>
                <div class="shift-desc">Exam preparation, test series & special coaching</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Students Table Card -->
  <div class="dash-card mb-4">
    <div class="dash-card-header d-flex justify-content-between align-items-center">
      <div>
        <h3 class="dash-card-title">
          <i class="bi bi-people-fill text-info me-2"></i> Enrolled Students Summary
        </h3>
        <span class="text-muted small">Recent admissions with assigned batch</span>
      </div>
      <a href="/admin/students" class="admin-page-link btn btn-sm btn-outline-primary">
        View All Students <i class="bi bi-arrow-right"></i>
      </a>
    </div>
    <div class="dash-card-body p-0">
      <div class="table-responsive">
        <table class="table align-middle mb-0 recent-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Student ID</th>
              <th>Name</th>
              <th>Class</th>
              <th>Shift / Batch</th>
              <th>Parent Phone</th>
            </tr>
          </thead>
          <tbody>
            {{#if recentStudents.length}}
              {{#each recentStudents}}
                <tr>
                  <td>{{inc @index}}</td>
                  <td><span class="badge bg-light text-dark border">{{this.studentId}}</span></td>
                  <td><strong>{{this.name}}</strong></td>
                  <td><span class="badge bg-secondary-subtle text-secondary">{{this.class}}</span></td>
                  <td>
                    {{#if (eq this.shift "Morning")}}
                      <span class="badge bg-warning text-dark"><i class="bi bi-sun"></i> Morning</span>
                    {{else if (eq this.shift "Afternoon")}}
                      <span class="badge bg-info text-dark"><i class="bi bi-brightness-high"></i> Afternoon</span>
                    {{else if (eq this.shift "Evening")}}
                      <span class="badge bg-primary"><i class="bi bi-moon-stars"></i> Evening</span>
                    {{else}}
                      <span class="badge bg-light text-muted">General</span>
                    {{/if}}
                  </td>
                  <td>{{this.parentNo}}</td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">
                  No students registered yet. Click <a href="/admin/students" class="admin-page-link">Register Student</a> to add.
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
