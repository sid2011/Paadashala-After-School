<div class="page-header">

    <div>
        <h1>Teachers</h1>
        <p>Manage all Paadashala teachers</p>
    </div>

    <button
        class="btn btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#registerTeacherModal">

        <i class="bi bi-person-plus"></i>
        Register Teacher

    </button>

</div>


<!-- REGISTER TEACHER MODAL -->

<div
    class="modal fade"
    id="registerTeacherModal"
    tabindex="-1"
    aria-labelledby="registerTeacherModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form action="/admin/teachers/register" method="POST">

                <!-- HEADER -->

                <div class="modal-head">

                    <div>

                        <h3 id="registerTeacherModalLabel">

                            <i
                                class="bi bi-person-plus-fill"
                                style="color:var(--p);margin-right:.35rem">
                            </i>

                            Register Teacher

                        </h3>

                        <p>Add a teacher to Paadashala.</p>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body">

                    <!-- NAME -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Teacher Name <span class="req">*</span>
                        </label>

                        <input
                            class="finput"
                            type="text"
                            name="name"
                            placeholder="Enter teacher's full name"
                            required>

                    </div>


                    <!-- PHONE + EMAIL -->

                    <div class="form-row form-mb">

                        <div>

                            <label class="form-lbl">
                                Phone <span class="req">*</span>
                            </label>

                            <input
                                class="finput"
                                type="tel"
                                name="phone"
                                placeholder="Enter phone number"
                                required>

                        </div>


                        <div>

                            <label class="form-lbl">
                                Email <span class="req">*</span>
                            </label>

                            <input
                                class="finput"
                                type="email"
                                name="email"
                                placeholder="Enter email address"
                                required>

                        </div>

                    </div>


                    <!-- SUBJECT -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Subject <span class="req">*</span>
                        </label>

                        <input
                            class="finput"
                            type="text"
                            name="subject"
                            placeholder="Enter subject taught"
                            required>

                    </div>


                    <!-- ADDRESS -->

                    <div class="form-mb">

                        <label class="form-lbl">
                            Address
                        </label>

                        <textarea
                            class="finput"
                            rows="3"
                            name="address"
                            placeholder="Enter teacher's address"></textarea>

                    </div>


                    <!-- INFO -->

                    <div class="xp-hint-box">

                        <i
                            class="bi bi-info-circle-fill"
                            style="color:var(--p);margin-right:.25rem">
                        </i>

                        A teacher ID and login credentials can be
                        generated after registration.

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary">

                        <i class="bi bi-person-plus-fill"></i>

                        Register Teacher

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>